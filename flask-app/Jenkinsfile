pipeline {
  agent {
    dockerfile {
      filename 'flask-app/ci/Dockerfile'
      args '-v /var/run/docker.sock:/var/run/docker.sock'
      reuseNode true
    }
  }

  parameters {
    string(
      name: 'DOCKERHUB_USER',
      defaultValue: 'poojavidhanam',
      description: 'Docker Hub username'
    )
  }

  environment {
    KUBE_NAMESPACE = 'commerce'
    IMAGE = "${params.DOCKERHUB_USER}/flask-commerce"
  }

  stages {
    stage('Test') {
      steps {
        dir('flask-app') {
          sh 'python3 -m pip install --break-system-packages -r requirements-dev.txt'
          sh 'python3 -m pytest -q'
        }
      }
    }

    stage('Build') {
      steps {
        dir('flask-app') {
          sh 'test -n "$DOCKERHUB_USER"'
          sh 'docker build --platform linux/arm64 -t ${IMAGE}:${BUILD_NUMBER} -t ${IMAGE}:latest .'
        }
      }
    }

    stage('Push') {
      steps {
        dir('flask-app') {
          withCredentials([
            usernamePassword(
              credentialsId: 'dockerhub',
              usernameVariable: 'DOCKER_USER',
              passwordVariable: 'DOCKER_TOKEN'
            )
          ]) {
            sh 'echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin'
            sh 'docker push ${IMAGE}:${BUILD_NUMBER}'
            sh 'docker push ${IMAGE}:latest'
          }
        }
      }
    }

    stage('Helm Validate') {
      steps {
        dir('flask-app') {
          sh 'helm lint helm/flask-commerce'
          sh '''
            helm template commerce helm/flask-commerce \
              --namespace ${KUBE_NAMESPACE} \
              --set image.repository=${IMAGE} \
              --set image.tag=${BUILD_NUMBER} \
              --set secret.create=false \
              --set secret.existingSecret=flask-commerce-secret \
              > /tmp/rendered.yaml
          '''
          sh 'grep -q "kind: Deployment" /tmp/rendered.yaml'
          sh 'grep -q "kind: StatefulSet" /tmp/rendered.yaml'
          sh 'grep -q "kind: NetworkPolicy" /tmp/rendered.yaml'
        }
      }
    }

    stage('Deploy') {
      steps {
        dir('flask-app') {
          withCredentials([
            file(
              credentialsId: 'commerce-kubeconfig',
              variable: 'KUBECONFIG_FILE'
            )
          ]) {
            sh '''
              helm upgrade --install commerce helm/flask-commerce \
                --namespace "${KUBE_NAMESPACE}" \
                --kubeconfig "$KUBECONFIG_FILE" \
                --set image.repository="${IMAGE}" \
                --set image.tag="${BUILD_NUMBER}" \
                --set secret.create=false \
                --set secret.existingSecret=flask-commerce-secret \
                --wait --timeout 10m
            '''
          }
        }
      }
    }

    stage('Verify') {
      steps {
        dir('flask-app') {
          withCredentials([
            file(
              credentialsId: 'commerce-kubeconfig',
              variable: 'KUBECONFIG_FILE'
            )
          ]) {
            sh '''
              kubectl --kubeconfig "$KUBECONFIG_FILE" \
                -n "${KUBE_NAMESPACE}" get deployments

              kubectl --kubeconfig "$KUBECONFIG_FILE" \
                -n "${KUBE_NAMESPACE}" rollout status \
                deployment/flask-commerce --timeout=5m

              kubectl --kubeconfig "$KUBECONFIG_FILE" \
                -n "${KUBE_NAMESPACE}" rollout status \
                deployment/flask-commerce-worker --timeout=5m

              kubectl --kubeconfig "$KUBECONFIG_FILE" \
                -n "${KUBE_NAMESPACE}" get pods,svc,ingress,hpa,pvc
            '''
          }
        }
      }
    }
  }
}
